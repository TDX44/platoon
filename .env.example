SECRET_KEY=change-this-to-a-random-secret
HTTPS=true
CLERK_PUBLISHABLE_KEY=pk_live_or_test_your_publishable_key_here
CLERK_SECRET_KEY=sk_live_or_test_your_secret_key_here
CLERK_FRONTEND_API_URL=https://your-instance.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=https://your-app-domain.example.com,http://localhost:5000
# Who may open /admin — the platform operator's dashboard, read-only and
# across every organization on this instance. Comma-separated, case-insensitive.
# The address is only accepted after Clerk confirms it is that account's
# VERIFIED primary email, so CLERK_SECRET_KEY above must be set for it to work.
# Set it to an empty value to turn the dashboard off entirely.
PLATFORM_ADMIN_EMAILS=jonathon.carr5@gmail.com
DB_OWNER_PASSWORD=change-this-to-a-random-password
DB_APP_PASSWORD=change-this-to-a-different-random-password
