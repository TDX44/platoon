accountability.db
data/*
!data/.gitkeep

__pycache__/
*.pyc

# Local DB snapshots written by scripts/backup-db.sh on the server
backups/

# Subagent-driven-development scratch (ledger, briefs, review packages)
.superpowers/

# Dev-stack-only port override; must never reach production
docker-compose.override.yml

# Secrets (SECRET_KEY, Clerk keys, TUNNEL_TOKEN, DB passwords) - never commit
.env
# ...and editor backups/copies of it (nano .env.save, .env.bak, .env.local).
# A secret in a sibling file is still a secret, and `.env` alone does not cover them.
.env.*
!.env.example
